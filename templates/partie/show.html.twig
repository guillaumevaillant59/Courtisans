{% extends 'base.html.twig' %}

{% block title %}Partie{% endblock %}

{% block body %}
    <h1>Partie</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ partie.id }}</td>
            </tr>
            <tr>
                <th>NombreJoueurMax</th>
                <td>{{ partie.nombreJoueurMax }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ partie.Status }}</td>
            </tr>
            <tr>
                <th>Joueurs</th>
                <td>
                    <ul>
                        {% for joueur in partie.joueurs %}
                            <li>{{ joueur.utilisateur.email }}</li>
                        {% endfor %}
                    </ul>
                </td>
            </tr>
            <tr>
            {% if partie.Status === 'en cours' %}            
                <th>Carte</th>
                {% for joueur in partie.joueurs %}
                        <tr>
                            <td>{{ joueur.utilisateur.pseudo }}</td>
                            <td>
                                {% for carte in joueur.main.cartes %}
                                    <ul>
                                        <li>{{ carte.role }} - {{ carte.famille }}</li>
                                        <img class="carte"src="{{ asset(carte.path) }}" alt="{{ carte.role }} - {{ carte.famille }}">
                                    </ul>
                                {% endfor %}
                            </td>
                            <td>
                                <img class="mission" src="{{ asset(joueur.missionBlanche.path) }}" alt="{{ joueur.missionBlanche.objectif }}">
                            </td>
                            <td>
                                <img class="mission" src="{{ asset(joueur.missionBleue.path) }}" alt="{{ joueur.missionBleue.objectif }}">
                            </td>
                        </tr>
                    {% endfor %}
                </tr>
                <tr>
                    <th>Pioche</th>
                    <td>{{ partie.pioche|length }}</td>
                </tr>
            {% endif %}
        </tbody>
    </table>
    <a href="{{ path('app_partie_index') }}">Retourner à la liste des parties</a>

    {{ include('partie/_delete_form.html.twig') }}
{% endblock %}
